# Copy to .env and adjust. Never commit the real .env file.

# Postgres (recommended target per PRD): e.g. a local instance, or a managed
# one from Supabase/Neon/Railway.
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/prithvi
#
# Leave unset (or use the sqlite line below) to run with zero setup — good
# for quickly testing this module or for other teammates' machines.
DATABASE_URL=sqlite:///./prithvi.db

# Comma-separated list of origins allowed to call this API (Vite dev server
# default shown below; add your deployed frontend URL too).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
